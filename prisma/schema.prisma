// Prisma schema for CardDex Pokémon TCG tracker
// Run `npm run prisma:generate` to create the Prisma client once dependencies are installed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Card {
  id                 String   @id
  name               String
  setId              String
  setName            String
  setSeries          String?
  printedTotal       Int?
  number             String
  rarity             String?
  imageSmallUrl      String
  imageLargeUrl      String
  tcgplayerProductId Int?
  priceJson          Json?

  collectionEntries  CollectionEntry[]

  @@index([name])
  @@index([number])
}

model CollectionEntry {
  id            Int       @id @default(autoincrement())
  cardId        String
  card          Card      @relation(fields: [cardId], references: [id])
  quantity      Int       @default(1)
  condition     String    @default("Near Mint")
  language      String    @default("EN")
  finish        String    @default("Normal")
  purchasePrice Float?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
